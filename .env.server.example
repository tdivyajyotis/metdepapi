# Copy this file to .env. Use long, independently generated random values.
POSTGRES_DB=sensors
POSTGRES_USER=sensor
POSTGRES_PASSWORD=replace-with-a-long-random-password

# JSON must remain on one line. Each device gets a separate secret.
DEVICE_TOKENS={"station-001":"replace-with-a-long-random-device-token"}

# Leave blank when Cloudflare Access protects all read routes.
READ_API_TOKEN=
API_PORT=8000
CORS_ORIGINS=

# Only needed when starting the optional tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

